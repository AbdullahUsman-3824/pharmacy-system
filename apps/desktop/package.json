{
  "name": "@pharmacy/desktop",
  "version": "1.0.0",
  "description": "Furqan Medicos Pharmacy POS",
  "author": "Furqan Medicos",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "dev:local": "cross-env NODE_ENV=development dotenv -- electron .",
    "build:resources": "node scripts/build-resources.cjs",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false pnpm build:resources && electron-builder"
  },
  "build": {
    "appId": "com.furqanmedicos.pos",
    "productName": "Furqan Medicos",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AbdullahUsman-3824",
        "repo": "pharmacy-system"
      }
    ]
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "dotenv-cli": "^8.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}

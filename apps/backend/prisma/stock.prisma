// ======================================================
// BATCH
// ======================================================

model Batch {
    id String @id @default(uuid())

    productId String
    product   Product @relation(fields: [productId], references: [id])

    supplierId String?
    supplier   Supplier? @relation(fields: [supplierId], references: [id])

    batchNumber String
    expiryDate  DateTime?

    purchaseRate Decimal @db.Decimal(10, 2)
    saleRate     Decimal @db.Decimal(10, 2)

    openingQuantity Int @default(0)
    currentQuantity Int @default(0)

    manufacturingDate DateTime?

    isActive Boolean @default(true)

    createdAt          DateTime           @default(now())
    updatedAt          DateTime           @updatedAt
    deletedAt          DateTime?
    stockVoucherItems  StockVoucherItem[]
    batchRateHistories BatchRateHistory[]

    @@unique([productId, batchNumber, expiryDate])
    @@index([batchNumber])
    @@index([expiryDate])
    @@index([productId])
}

model BatchRateHistory {
    id              String   @id @default(cuid())
    batchId         String
    batch           Batch    @relation(fields: [batchId], references: [id])
    oldPurchaseRate Decimal
    oldSaleRate     Decimal
    newPurchaseRate Decimal
    newSaleRate     Decimal
    changedAt       DateTime @default(now())
}

// ======================================================
// STOCK VOUCHER — covers both Product Opening and Purchase
// ======================================================

enum StockVoucherType {
    OPENING
    PURCHASE
    PURCHASE_RETURN
    STOCK_ADJUSTMENT
    STOCK_TRANSFER
}

model StockVoucher {
    id String @id @default(uuid())

    voucherNumber String @unique

    type StockVoucherType

    date DateTime @default(now())

    supplierId String?
    supplier   Supplier? @relation(fields: [supplierId], references: [id])

    remarks String?

    grossAmount    Decimal @default(0) @db.Decimal(12, 2)
    discountAmount Decimal @default(0) @db.Decimal(12, 2)
    taxAmount      Decimal @default(0) @db.Decimal(12, 2)
    netAmount      Decimal @default(0) @db.Decimal(12, 2)

    items StockVoucherItem[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@index([voucherNumber])
    @@index([date])
}

model StockVoucherItem {
    id String @id @default(uuid())

    voucherId String
    voucher   StockVoucher @relation(fields: [voucherId], references: [id])

    productId String
    product   Product @relation(fields: [productId], references: [id])

    batchId String
    batch   Batch  @relation(fields: [batchId], references: [id])

    purchaseRate Decimal @db.Decimal(10, 2)

    saleRate Decimal @db.Decimal(10, 2)

    quantity Int

    freeQuantity Int @default(0)

    grossAmount Decimal @db.Decimal(12, 2)

    discountPercent Decimal? @db.Decimal(5, 2)

    discountAmount Decimal @default(0) @db.Decimal(12, 2)

    taxPercent Decimal? @db.Decimal(5, 2)

    taxAmount Decimal @default(0) @db.Decimal(12, 2)

    netAmount Decimal @db.Decimal(12, 2)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([productId])
    @@index([batchId])
}

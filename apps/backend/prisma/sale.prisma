// ======================================================
// SALE — covers both Sale and Sale Return
// ======================================================

enum SaleType {
    SALE
    SALE_RETURN
}

model Sale {
    id String @id @default(uuid())

    saleNumber String @unique

    type SaleType @default(SALE)

    date DateTime @default(now())

    customerName String  @default("Walk-in Customer")
    remarks      String?

    // for SALE_RETURN: link back to the original sale being returned against
    originalSaleId String?
    originalSale   Sale?   @relation("SaleReturns", fields: [originalSaleId], references: [id])
    returns        Sale[]  @relation("SaleReturns")

    grossAmount Decimal @default(0) @db.Decimal(12, 2)

    // bill-level discount/tax — applied once on the invoice total, not per line
    discountPercent Decimal? @db.Decimal(5, 2)
    discountAmount  Decimal  @default(0) @db.Decimal(12, 2)

    taxPercent Decimal? @db.Decimal(5, 2)
    taxAmount  Decimal  @default(0) @db.Decimal(12, 2)

    netAmount Decimal @default(0) @db.Decimal(12, 2)

    items SaleItem[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@index([saleNumber])
    @@index([date])
    @@index([type])
}

model SaleItem {
    id String @id @default(uuid())

    saleId String
    sale   Sale   @relation(fields: [saleId], references: [id])

    productId String
    product   Product @relation(fields: [productId], references: [id])

    batchId String
    batch   Batch  @relation(fields: [batchId], references: [id])

    packQuantity Int     @default(0)
    saleRate     Decimal @db.Decimal(10, 2)

    looseQuantity Int      @default(0)
    looseRate     Decimal? @db.Decimal(10, 2)

    grossAmount Decimal @db.Decimal(12, 2)
    netAmount   Decimal @db.Decimal(12, 2)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([productId])
    @@index([batchId])
    @@index([saleId])
}

model SaleNumberCounter {
  id      String   @id @default(cuid())
  type    SaleType
  dateKey String
  seq     Int      @default(0)

  @@unique([type, dateKey])
}

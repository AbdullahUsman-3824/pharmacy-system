// ======================================================
// SALE — covers both Sale and Sale Return
// ======================================================

enum SaleType {
    SALE
    SALE_RETURN
}

model Sale {
    id String @id @default(uuid())

    saleNumber String @unique

    type SaleType @default(SALE)

    date DateTime @default(now())

    customerId String
    customer   BusinessContact @relation(fields: [customerId], references: [id])

    remarks String?

    // for SALE_RETURN: link back to the original sale
    originalSaleId String?
    originalSale   Sale?   @relation("SaleReturns", fields: [originalSaleId], references: [id])
    returns        Sale[]  @relation("SaleReturns")

    grossAmount Decimal @default(0) @db.Decimal(12, 2)

    // bill-level discount/tax
    discountPercent Decimal? @db.Decimal(5, 2)
    discountAmount  Decimal  @default(0) @db.Decimal(12, 2)

    taxPercent Decimal? @db.Decimal(5, 2)
    taxAmount  Decimal  @default(0) @db.Decimal(12, 2)

    netAmount Decimal @default(0) @db.Decimal(12, 2)

    items    SaleItem[]
    payments Payment[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@index([deletedAt])
    @@index([date(sort: Desc)])
    @@index([saleNumber])
    @@index([customerId])
    @@index([type])
    @@index([originalSaleId])
    @@index([date, type])
}

model SaleItem {
    id String @id @default(uuid())

    saleId String
    sale   Sale   @relation(fields: [saleId], references: [id])

    productId String
    product   Product @relation(fields: [productId], references: [id])

    batchId String
    batch   Batch  @relation(fields: [batchId], references: [id])

    packQuantity Int     @default(0)
    saleRate     Decimal @db.Decimal(10, 2)

    looseQuantity Int      @default(0)
    looseRate     Decimal? @db.Decimal(10, 2)

    grossAmount Decimal @db.Decimal(12, 2)
    netAmount   Decimal @db.Decimal(12, 2)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // ========== OPTIMIZED INDEXES ==========
    @@index([saleId])
    @@index([productId])
    @@index([batchId])
    // Composite index for returnable items query (productId + batchId)
    @@index([productId, batchId])
    // Index for finding previous returns quickly
    @@index([saleId, productId, batchId])
}

model SaleNumberCounter {
    id      String   @id @default(cuid())
    type    SaleType
    dateKey String
    seq     Int      @default(0)

    @@unique([type, dateKey])
}

// ======================================================
// DISTRIBUTOR
// ======================================================

model Distributor {
    id String @id @default(uuid())

    name String

    contactPerson String?

    phone  String?
    mobile String?
    email  String?

    address String?
    city    String?

    openingBalance Decimal? @db.Decimal(12, 2)

    isActive Boolean @default(true)

    products      Product[]
    batches       Batch[]
    stockVouchers StockVoucher[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@index([name])
}

// ======================================================
// CUSTOMER
// ======================================================

model Customer {
    id String @id @default(uuid())

    code String @unique
    name String

    phone   String?
    address String?

    creditLimit    Decimal? @db.Decimal(12, 2)
    openingBalance Decimal  @default(0) @db.Decimal(12, 2)

    isActive Boolean @default(true)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@index([name])
}

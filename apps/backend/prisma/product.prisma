// ======================================================
// PREREQUISITES
// ======================================================

model Company {
    id   String @id @default(uuid())
    code String @unique
    name String

    products Product[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@index([name])
}

model ProductType {
    id   String @id @default(uuid())
    code String @unique
    name String

    products Product[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@index([name])
}

model ProductGroup {
    id   String @id @default(uuid())
    code String @unique
    name String

    products Product[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@index([name])
}

model Generic {
    id   String @id @default(uuid())
    code String @unique
    name String

    products Product[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@index([name])
}

// ======================================================
// PRODUCT
// ======================================================

model Product {
    id String @id @default(uuid())

    code    String  @unique
    barcode String? @unique

    name String

    companyId String
    typeId    String
    groupId   String
    genericId String

    defaultSupplierId String?

    company Company      @relation(fields: [companyId], references: [id])
    type    ProductType  @relation(fields: [typeId], references: [id])
    group   ProductGroup @relation(fields: [groupId], references: [id])
    generic Generic      @relation(fields: [genericId], references: [id])

    defaultSupplier Supplier? @relation(fields: [defaultSupplierId], references: [id])

    registrationNo    String?
    originalReference String?

    // packing / pricing
    packingSize    String?
    retailPrice    Decimal? @db.Decimal(10, 2)
    retailDiscount Decimal? @db.Decimal(5, 2)
    tradePrice     Decimal? @db.Decimal(10, 2)

    // rates (auto-calculated by service layer from the above)
    retailRate         Decimal? @db.Decimal(10, 2)
    tradeRate          Decimal? @db.Decimal(10, 2)
    counterRatePercent Decimal? @db.Decimal(5, 2)
    orgRatePercent     Decimal? @db.Decimal(5, 2)

    minimumStock Int  @default(0)
    maximumStock Int?

    shelfNo Int?

    isActive     Boolean @default(true)
    nivFormulary Boolean @default(false)

    batches           Batch[]
    stockVoucherItems StockVoucherItem[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@index([name])
    @@index([barcode])
}

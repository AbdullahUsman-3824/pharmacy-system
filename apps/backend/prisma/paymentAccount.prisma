enum PaymentAccountType {
    CASH
    BANK
}

model PaymentAccount {
    id   String             @id @default(uuid())
    name String
    type PaymentAccountType

    isActive Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    payments Payment[]

    @@index([type])
    @@index([name])
}
